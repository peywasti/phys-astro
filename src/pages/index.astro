---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const domain = "phys.ir";
---

<Layout
  title={`${domain} — Domain For Sale`}
  description={`The premium domain ${domain} is available for purchase. Short, memorable, and brandable. Make an offer today.`}
>
  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <h1 class="domain-name animate-in">
          phys<span class="domain-tld">.ir</span>
        </h1>
        <div class="divider animate-in delay-1"></div>
        <p class="tagline animate-in delay-2">
          This premium domain is available for sale
        </p>
        <a href="#contact" class="cta-button animate-in delay-3">
          <span>Make an Offer</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section contact-section">
      <div class="container">
        <h2 class="section-title">Interested?</h2>
        <div class="contact-box">
          <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">
            Serious inquiries only. Send your best offer.
          </p>
          <a id="email-link" href="#" class="contact-email">Send us an email</a>
          <div style="margin-top: 2rem;">
            <a id="email-cta" href="#" class="cta-button">
              <span>Email Us Now</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <p>© {new Date().getFullYear()} {domain} — All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      const email = atob("YWJiYXN6YWRlaEBnbWFpbC5jb20=");
      const subject = "Offer for phys.ir";
      const link = document.getElementById("email-link");
      const cta = document.getElementById("email-cta");
      if (link) {
        link.href = "mailto:" + email;
        link.textContent = email;
      }
      if (cta) {
        cta.href =
          "mailto:" + email + "?subject=" + encodeURIComponent(subject);
      }
    })();
  </script>
</Layout>
